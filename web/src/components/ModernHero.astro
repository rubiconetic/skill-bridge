---
import { Icon } from '@lucide/astro';

interface Props {
	title: string;
	tagline: string;
	image?: { file: string };
	actions: Array<{ text: string; link: string; icon?: string; variant?: 'primary' | 'minimal' }>;
}

const { title, tagline, actions } = Astro.props;
---

<section class="relative overflow-hidden py-24 sm:py-32">
	<!-- Background Ambient Glow -->
	<div class="absolute -top-24 left-1/2 -z-10 -translate-x-1/2 blur-3xl sm:-top-48 overflow-hidden pointer-events-none">
		<div class="aspect-[1108/632] w-[69.25rem] bg-gradient-to-r from-primary-500 to-cyan-500 opacity-20 transform rotate-[30deg]"></div>
	</div>

	<div class="mx-auto max-w-7xl px-6 lg:px-8 relative z-10">
		<div class="mx-auto max-w-2xl text-center">
			<h1 class="text-4xl font-bold tracking-tight text-white sm:text-7xl bg-clip-text text-transparent bg-gradient-to-r from-white via-primary-100 to-white/70">
				{title}
			</h1>
			<p class="mt-6 text-lg leading-8 text-gray-300">
				{tagline}
			</p>
			<div class="mt-10 flex items-center justify-center gap-x-6">
				{actions.map((action) => (
					<a
						href={action.link}
						class:list={[
							'inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300',
							action.variant === 'primary' 
								? 'bg-primary-600 text-white shadow-lg shadow-primary-500/20 hover:bg-primary-500 hover:shadow-primary-500/40 hover:-translate-y-0.5' 
								: 'glass text-white hover:bg-white/10 hover:-translate-y-0.5'
						]}
					>
						{action.text}
						{action.icon === 'right-arrow' && <Icon name="arrow-right" class="w-4 h-4" />}
						{action.icon === 'document' && <Icon name="file-text" class="w-4 h-4" />}
					</a>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	h1 {
		line-height: 1.1;
		margin-bottom: 0.5rem;
	}
</style>
